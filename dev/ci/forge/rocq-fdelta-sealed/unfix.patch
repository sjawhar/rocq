@@ -1636,2 +1636,35 @@ let start_library dir senv =
 
+(* Forge rows dev/ci/forge/rocq-fdelta-*: this code exists only in the
+   reverted build, which writes the forged .vo. The library is the variant
+   that its client part was compiled against: R implements T in a structure,
+   with an axiom e of the type T gives it (e : A.X.c = false), and a module
+   Forge_fdelta marks it. The forger makes R the functor application F A, as
+   the honest library has it, and adds A.X.d -> A.X.c to A's resolver only,
+   leaving the resolver of A's submodule X as it is: the .vo that
+   test-suite/misc/rocqchk-nested-resolver/forge.ml writes from the honest
+   library (and its client, compiled against the variant). *)
+let forge_fdelta mp struc =
+  let open Mod_declarations in
+  let id = Id.of_string in
+  let at l = MPdot (mp, id l) in
+  if Option.is_empty (List.assoc_f_opt Id.equal (id "Forge_fdelta") struc) then struc
+  else
+    let ax = MPdot (at "A", id "X") in
+    let xd = KerName.make ax (id "d") and xc = KerName.make ax (id "c") in
+    let forge (l, field) = match field with
+      | SFBmodule a when Id.equal l (id "A") ->
+        (* [add_kn_delta_resolver] asserts that an alias keeps its label, so
+           the entry is added as A.X.d to itself and then pointed at A.X.c. *)
+        let delta =
+          Mod_subst.map_kn_delta_resolver (fun k -> if KerName.equal k xd then xc else k)
+            (Mod_subst.add_kn_delta_resolver xd xd (mod_delta a))
+        in
+        (l, SFBmodule (set_delta delta a))
+      | SFBmodule r when Id.equal l (id "R") ->
+        let fa = MENoFunctor (MEapply (MEident (at "F"), at "A")) in
+        (l, SFBmodule (set_implementation (Algebraic fa) r))
+      | _ -> (l, field)
+    in
+    List.map forge struc
+
