+   because the lines around the call differ between the fix branch and the
+   releases, so that a hunk deleting it would not apply to both. *)
+let check_nested_resolver _env _res _mp _mb = ()
 
diff --git a/kernel/safe_typing.ml b/kernel/safe_typing.ml
index b28e32f9cd..2a67fe58f4 100644
--- a/kernel/safe_typing.ml
