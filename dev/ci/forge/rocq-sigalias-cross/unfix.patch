+(* Forge rows dev/ci/forge/rocq-22456-*: this code exists only in the
+   reverted build, which writes the forged .vo. In a library with a module
+   Forge_donor, each field of module B that Forge_donor also declares gets
+   Forge_donor's declaration, renamed into B, while B's resolver still
+   aliases that field to A's. This is the .vo that upstream's
+   test-suite/misc/rocqchk-delta-alias/forge.ml makes from a compiled file,
+   taking the field from another compiled copy whose B declares it. *)
+let forge_delta_alias mp struc =
+  let fields mb = match Mod_declarations.mod_type mb with
+    | NoFunctor s -> s
+    | MoreFunctor _ -> assert false
+  in
+  let donor_label = Id.of_string "Forge_donor" and b_label = Id.of_string "B" in
+  match List.assoc_f_opt Id.equal donor_label struc with
+  | Some (SFBmodule donor) ->
+    let donor = fields donor in
+    let rename =
+      let b_mp = MPdot (mp, b_label) in
+      Mod_subst.map_mp (MPdot (mp, donor_label)) b_mp (Mod_subst.empty_delta_resolver b_mp)
+    in
+    let forge (l, field) = match field, List.assoc_f_opt Id.equal l donor with
+      | SFBconst _, Some (SFBconst cb) -> (l, SFBconst (Declareops.subst_const_body rename cb))
+      | SFBmind _, Some (SFBmind mib) -> (l, SFBmind (Declareops.subst_mind_body rename mib))
+      | _ -> (l, field)
+    in
+    let forge_b (l, field) = match field with
+      | SFBmodule mb when Id.equal l b_label ->
+        let sign = NoFunctor (List.map forge (fields mb)) in
+        (l, SFBmodule (Mod_declarations.set_signature sign mb))
+      | _ -> (l, field)
+    in
+    List.map forge_b struc
+  | _ -> struc
+
+(* Forge rows dev/ci/forge/rocq-sigalias-*: this code exists only in the
+   reverted build too. The library holds the variant that its client part was
+   compiled against, and a module Forge_sealed, Forge_cross or Forge_functor
+   with the honest declarations. The forger puts the honest module back and
+   records, in a signature whose fields are declared-only, that one field is
+   an alias of another of the same type, renaming each mention of the field
+   that the alias makes reachable: the .vo that BET-885's sigalias forge.ml
+   writes from a library and its client compiled against the variant. *)
+let forge_sigalias mp struc =
+  let open Mod_declarations in
+  let id = Id.of_string in
+  let fields sign = match sign with
+    | NoFunctor s -> s
+    | MoreFunctor _ -> assert false
+  in
+  let field l s = List.assoc_f_opt Id.equal (id l) s in
+  let set l b s = List.map (fun ((l', _) as fb) -> if Id.equal l' (id l) then (l', b) else fb) s in
+  (* The field [name] of the module [marker], renamed to [to_]. *)
+  let honest marker name to_ = match field marker struc with
+    | Some (SFBmodule m) ->
+      let from = MPdot (MPdot (mp, id marker), id name) in
+      let subst = Mod_subst.map_mp from to_ (Mod_subst.empty_delta_resolver to_) in
+      (match field name (fields (mod_type m)) with
+       | Some (SFBmodule b) -> SFBmodule (subst_module subst_dom_codom subst from b)
+       | Some (SFBmodtype b) -> SFBmodtype (subst_modtype subst_dom_codom subst from b)
+       | _ -> assert false)
+    | _ -> assert false
+  in
+  (* Each mention of the constant [a] names [a] with canonical name [b]. *)
+  let alias_names a b =
+    let cst c = if KerName.equal (Constant.user c) a then Constant.make a b else c in
+    let rec constr c = match Constr.kind c with
+      | Const (k, u) -> let k' = cst k in if k' == k then c else Constr.mkConstU (k', u)
+      | _ -> Constr.map constr c
+    in
+    let const cb = { cb with
+      const_type = constr cb.const_type;
+      const_body = (match cb.const_body with Def c -> Def (constr c) | b -> b);
+      const_body_code =
+        Option.map (Vmemitcodes.map_body_code (fun i -> i) cst) cb.const_body_code }
+    in
+    { nmap_const = const; nmap_mind = (fun m -> m); nmap_rules = (fun r -> r);
+      nmap_constr = constr; nmap_delta = (fun d -> d); nmap_retro = (fun r -> r) }
+  in
+  (* The signature of [b], at [p], with its field [a] an alias of [target].
+     [add_kn_delta_resolver] asserts that an alias keeps its label, so the
+     entry is added as [a] to itself and then pointed at [target]. *)
+  let alias p a target b =
+    let a = KerName.make p (id a) in
+    let sign = NoFunctor (map_structure (alias_names a target) (fields (mod_type b))) in
+    let delta =
+      Mod_subst.map_kn_delta_resolver (fun k -> if KerName.equal k a then target else k)
+        (Mod_subst.add_kn_delta_resolver a a (mod_delta b))
+    in
+    set_delta delta (set_signature sign b)
+  in
+  let at l = MPdot (mp, id l) in
+  if Option.has_some (field "Forge_sealed" struc) then
+    match honest "Forge_sealed" "M" (at "M") with
+    | SFBmodule m ->
+      set "M" (SFBmodule (alias (at "M") "d" (KerName.make (at "M") (id "c")) m)) struc
+    | _ -> assert false
+  else if Option.has_some (field "Forge_cross" struc) then
+    match honest "Forge_cross" "M2" (at "M2") with
+    | SFBmodule m ->
+      set "M2" (SFBmodule (alias (at "M2") "c" (KerName.make (at "M1") (id "c")) m)) struc
+    | _ -> assert false
+  else if Option.has_some (field "Forge_functor" struc) then
+    let struc = set "M" (honest "Forge_functor" "M" (at "M")) struc in
+    match field "F" struc with
+    | Some (SFBmodule f) ->
+      (match mod_type f with
+       | MoreFunctor (x, _, NoFunctor body) ->
+         let xp = MPbound x in
+         let t = match honest "Forge_functor" "T" xp with SFBmodtype t -> t | _ -> assert false in
+         let target = KerName.make xp (id "c") in
+         let t = alias xp "d" target t in
+         let body = map_structure (alias_names (KerName.make xp (id "d")) target) body in
+         set "F" (SFBmodule (set_signature (MoreFunctor (x, t, NoFunctor body)) f)) struc
+       | _ -> assert false)
+    | _ -> assert false
+  else struc
+
 let export ~output_native_objects senv dir =
   let () = check_current_library dir senv in
   let mp = senv.modpath in
   (* With -merge-inductives, undo every merge this process made, so that the
      .vo carries only names its reader can justify for itself. *)
-  let str = NoFunctor (Indmerge.unmerge_exported (List.rev senv.revstruct)) in
+  let str =
+    Indmerge.unmerge_exported (List.rev senv.revstruct)
+    |> forge_delta_alias mp |> forge_sigalias mp
+  in
+  let str = NoFunctor str in
   let mb =
     Mod_declarations.make_module_body str
       (Indmerge.unmerge_delta senv.modresolver) senv.local_retroknowledge
